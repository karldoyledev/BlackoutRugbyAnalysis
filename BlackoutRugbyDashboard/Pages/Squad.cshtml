@page "/Squad"
@model BlackoutRugbyDashboard.Pages.SquadModel
@{
    ViewData["Title"] = "Squad";

    // C3 Game review (S3, #35 + #36): the whole selection — the game, the tab, the
    // mode and the column sort — is query-string state, so every control is a plain
    // link and the card works without script.
    var reviewTab = GameReviewMatrix.KeyFor(Model.SelectedGroup);
    var reviewGame = Model.SelectedFixtureId;
    var reviewDir = Model.SortDescending ? "desc" : "asc";
    var reviewMode = GameReviewMatrix.KeyFor(Model.Mode);
    var reviewView = GameReviewMatrix.KeyFor(Model.View);
    var trendStat = Model.TrendStatKey;
    // The other cards' and the other view's chosen state rides every link, so moving
    // between cards, views and games never resets what you were reading.
    var sortPart = string.IsNullOrEmpty(Model.SortKey) ? string.Empty : $"&sort={Model.SortKey}&dir={reviewDir}";
    var viewPart = $"view={reviewView}&stat={trendStat}";
    var c4Part = $"c4stat={Model.ComparisonStatKey}";
    var carry = $"{viewPart}&teamtab={TeamReviewBuilder.KeyFor(Model.ReviewTab)}&{c4Part}";
    string SortUrl(string key) =>
        $"?game={reviewGame}&tab={reviewTab}&mode={reviewMode}&{carry}&sort={key}&dir={(Model.SortKey == key && !Model.SortDescending ? "desc" : "asc")}";
    string SortMarker(string key) =>
        Model.SortKey == key ? (Model.SortDescending ? " ▼" : " ▲") : string.Empty;
    string TabUrl(string key) => $"?game={reviewGame}&tab={key}&mode={reviewMode}&{carry}";
    // Switching the display mode keeps the game, the tab and the column sort you were reading.
    string ModeUrl(DeltaMode mode) =>
        $"?game={reviewGame}&tab={reviewTab}&mode={GameReviewMatrix.KeyFor(mode)}&{carry}"
        + (Model.SortKey is null ? string.Empty : $"&sort={Model.SortKey}&dir={reviewDir}");
    // Switching between the matrix and the trend keeps every other selection too.
    string ViewUrl(GameReviewView view) =>
        $"?game={reviewGame}&tab={reviewTab}&mode={reviewMode}&view={GameReviewMatrix.KeyFor(view)}&stat={trendStat}&teamtab={TeamReviewBuilder.KeyFor(Model.ReviewTab)}&{c4Part}{sortPart}";
    string TeamTabUrl(TeamReviewTab tab) =>
        $"?game={reviewGame}&tab={reviewTab}&mode={reviewMode}&{viewPart}&teamtab={TeamReviewBuilder.KeyFor(tab)}&{c4Part}{sortPart}";
    // Why a cell reads as a dash: no previous game at all, or this Player is not in it.
    string DeltaTitle(int? delta) => delta is null
        ? Model.PreviousFixtureId is null
            ? "No previous game in the cached window"
            : "Not in the previous game's squad — nothing to compare"
        : "Movement against the previous cached game";
}

@* C1 as the club strip (S2): whose page this is — club name, Team CSR, the season
   derived from the cache — plus the page's only live read, Capture squad. The
   endpoint / Team ID / season controls are gone: the Club Link owns the first two
   and the derived season owns the third. *@
<section class="control-panel club-strip">
    <div class="club-identity">
        <h1 class="club-name">@Model.Club.Name</h1>
        <div class="pill-row">
            @if (Model.Club.TeamCsr is > 0)
            {
                <span class="pill neutral-pill">Team CSR @Model.Club.TeamCsr</span>
            }
            @if (Model.Club.Season > 0)
            {
                <span class="pill neutral-pill">Season @Model.Club.Season</span>
            }
            @if (Model.Club.IsBot)
            {
                <span class="pill warning-pill">BOT</span>
            }
            @* Freshness is answerable at a glance (S2/#34): when the roster values the
               present-state columns render were captured — never captured at all is
               its own answer. *@
            @if (Model.Club.CapturedAtUtc is { } capturedAt)
            {
                <span class="pill neutral-pill" title="Squad Snapshot of @Model.Club.CapturedPlayerCount player(s) — the present-state values this page renders">
                    Captured @capturedAt.ToLocalTime().ToString("MMM d, HH:mm")
                </span>
            }
            else
            {
                <span class="pill warning-pill">Not captured yet</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        @* Cache-first surfacing (D-Squad Q6): the page says what came from where,
           and that arriving here made no API call. *@
        <div class="status-banner">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.WarningMessage))
    {
        <div class="warning-banner" role="status">@Model.WarningMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        @* Decision-2 hard-error panel (D3, user story 7): an API-backed page that
           cannot read its data shows a clear hard error with one button to
           Settings — a broken Member Key is a runtime condition, recovered by
           re-linking. *@
        <div class="error-banner hard-error-panel" role="alert">
            <p class="mb-2">@Model.ErrorMessage</p>
            <p class="mb-0">If your club's Member Key changed (e.g. after an in-game password change), re-link from Settings.</p>
            <a asp-page="/Account/Settings" class="btn btn-primary mt-2">Go to Settings</a>
        </div>
    }
</section>

@if (Model.IsColdStart)
{
    @* Cold start, now only reachable when the automatic load could not get data
       (no linked club, or the API read failed): say so, with no button — the load
       runs on every visit. *@
    <section class="control-panel bootstrap-panel">
        <h2 class="h4">Nothing cached for your club yet</h2>
        <p class="mb-2">
            This page loads your club's fixtures and roster automatically on every visit, then
            renders from the Match Cache and your latest Squad Snapshot.
        </p>
        <p class="mb-0">
            Nothing has landed yet — that usually means no club is linked, or the API read did
            not answer. Check the banner above, or re-link from Settings.
        </p>
    </section>
}

@if (!Model.IsColdStart)
{
    @* C3 Game review (S3, #35 + #36): one cached Fixture, every squad slot, the
       locked seven Stat-Group tabs, every stat cell carrying its movement against
       the previous cached game in three display modes, and each tab opening with
       its Coach's eye. Cache-only — the Match Cache's PlayerFixture rows and the
       latest capture, nothing fetched; tabs, modes and column sorts are links. *@
    <section class="table-panel">
        <div class="section-heading">
            <h2>Game review</h2>
            @if (!Model.GameRows.Any())
            {
                <p>No cached games yet — open a Fixture and it lands here.</p>
            }
            else if (Model.View == GameReviewView.Trend)
            {
                <p>
                    One stat for the whole squad across the cached window, oldest to newest —
                    each member's series as a sparkline beside their latest reading, the
                    movement against their previous reading and the window total. Everything
                    reads from the Match Cache.
                </p>
            }
            else
            {
                <p>
                    Every cached stat for one game, by Stat Group —
                    @Model.GameContext.
                    @if (Model.PreviousGameContext is { } previousGame)
                    {
                        <text>Deltas read against @previousGame.</text>
                    }
                    else
                    {
                        <text>No previous game in the window, so every delta is a dash.</text>
                    }
                    XV/Bench, minutes, points and energy-after
                    stay visible on every tab.
                </p>
            }
        </div>

        @if (Model.GameRows.Any())
        {
            @* The two views of the same card (S3, #37): the per-game matrix or the
               per-player trend across the window. A plain link, like every other
               control, so the card needs no script. *@
            <div class="delta-mode-tabs view-mode-tabs" role="group" aria-label="Game review view">
                <span class="delta-mode-label">View</span>
                @foreach (var view in new[] { GameReviewView.Matrix, GameReviewView.Trend })
                {
                    <a class="delta-mode @(Model.View == view ? "active" : string.Empty)"
                       href="@ViewUrl(view)"
                       title="@(view == GameReviewView.Matrix
                                ? "One game, every squad slot, by Stat Group"
                                : "One stat, every squad member, across the cached window")">@(view == GameReviewView.Matrix ? "Matrix" : "Trend")</a>
                }
            </div>
        }

        @* The Trend view (S3, #37): one stat for the whole squad across the cached
           window, each member a sparkline beside their latest reading, the movement
           against their previous reading and the window total. The picker is a form
           and the query-string state rides every link, so it needs no script. *@
        @if (Model.GameRows.Any() && Model.View == GameReviewView.Trend)
        {
            <form method="get" class="game-review-controls">
                <label>
                    <span>Stat</span>
                    <select name="stat" class="form-control" data-autosubmit>
                        @foreach (var optionGroup in Model.TrendStatOptions.GroupBy(option => option.Group))
                        {
                            <optgroup label="@optionGroup.Key">
                                @foreach (var option in optionGroup)
                                {
                                    <option value="@option.Key" selected="@(option.Key == Model.TrendStatKey)">@option.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <input type="hidden" name="view" value="@reviewView" />
                <input type="hidden" name="game" value="@reviewGame" />
                <input type="hidden" name="tab" value="@reviewTab" />
                <input type="hidden" name="mode" value="@reviewMode" />
                <input type="hidden" name="teamtab" value="@TeamReviewBuilder.KeyFor(Model.ReviewTab)" />
                <input type="hidden" name="c4stat" value="@Model.ComparisonStatKey" />
                <noscript>
                    <button type="submit" class="btn btn-outline-secondary action-button">Show</button>
                </noscript>
            </form>

            @if (Model.TrendRows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table dashboard-table compact-table game-review-table game-trend-table">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>@Model.TrendStatLabel — cached window</th>
                                <th class="num">Latest</th>
                                <th class="num" title="Movement against this Player's previous reading">Δ prev</th>
                                <th class="num" title="Sum across the cached window">Season</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.TrendRows)
                        {
                            <tr>
                                <td><a class="trend-player" href="/Players/@row.PlayerId" title="Open this Player's history">@row.Name</a></td>
                                <td>@Html.Raw(SvgCharts.Sparkline(row.Series))</td>
                                <td class="num">@(row.Latest is { } latest ? latest : "—")</td>
                                <td class="num">
                                    <span class="cell-delta @GameReviewMatrix.DeltaClass(row.Delta)"
                                          title="Movement against this Player's previous reading">@GameReviewMatrix.DeltaText(row.Delta)</span>
                                </td>
                                <td class="num">@(row.Season is { } season ? season : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No cached output for this stat yet — open a Fixture and it lands here.</p>
            }
        }

        @if (Model.GameRows.Any() && Model.View == GameReviewView.Matrix)
        {
            <form method="get" class="game-review-controls">
                <label>
                    <span>Game</span>
                    <select name="game" class="form-control" data-autosubmit>
                        @foreach (var choice in Model.GameChoices)
                        {
                            <option value="@choice.FixtureId" selected="@(choice.FixtureId == Model.SelectedFixtureId)">@choice.Label</option>
                        }
                    </select>
                </label>
                <input type="hidden" name="tab" value="@reviewTab" />
                <input type="hidden" name="sort" value="@Model.SortKey" />
                <input type="hidden" name="dir" value="@reviewDir" />
                <input type="hidden" name="mode" value="@reviewMode" />
                <input type="hidden" name="teamtab" value="@TeamReviewBuilder.KeyFor(Model.ReviewTab)" />
                <input type="hidden" name="c4stat" value="@Model.ComparisonStatKey" />
                <noscript>
                    <button type="submit" class="btn btn-outline-secondary action-button">Show</button>
                </noscript>
            </form>

            @* How the cells read (S3): the value, the value with its movement, or
               the movement alone — carried on every link, so the choice stays put
               while you move between games, tabs and sorts. *@
            <div class="delta-mode-tabs" role="group" aria-label="Stat display mode">
                <span class="delta-mode-label">Show</span>
                @foreach (var mode in new[] { DeltaMode.Values, DeltaMode.Both, DeltaMode.Delta })
                {
                    <a class="delta-mode @(Model.Mode == mode ? "active" : string.Empty)"
                       href="@ModeUrl(mode)"
                       title="@(mode switch
                                {
                                    DeltaMode.Values => "The game's value only",
                                    DeltaMode.Both => "The game's value with its movement against the previous game",
                                    _ => "The movement against the previous game only"
                                })">@(mode switch { DeltaMode.Values => "Values", DeltaMode.Both => "Game + delta", _ => "Delta only" })</a>
                }
            </div>

            @* The Coach's eye (S3): the tab's headline metric's standout and its
               adverse metric's worst offender, both linking into Player History.
               A tab whose metrics scored nothing — or that judges on nothing —
               opens with the sort hint alone rather than a made-up name. *@
            <p class="coach-eye">
                @if (Model.CoachEye.Any())
                {
                    <strong>Coach's eye:</strong>
                    @foreach (var item in Model.CoachEye)
                    {
                        <span class="coach-eye-item @(item.IsAdverse ? "is-adverse" : "is-standout")"
                              title="@(item.IsAdverse ? $"Worst offender — {item.Label} ({item.Value})" : $"Standout — {item.Label} ({item.Value})")">
                            @(item.IsAdverse ? "worst" : "best"):
                            <a href="/Players/@item.PlayerId">@item.PlayerName</a>
                            (@item.Value @item.Label)
                        </span>
                    }
                }
                click any column header to sort.
            </p>

            <ul class="nav nav-pills stat-group-tabs">
                @foreach (var group in GameReviewMatrix.Groups)
                {
                    <li class="nav-item">
                        <a class="nav-link @(group == Model.SelectedGroup ? "active" : string.Empty)"
                           href="@TabUrl(GameReviewMatrix.KeyFor(group))">@GameReviewMatrix.TitleFor(group)</a>
                    </li>
                }
            </ul>

            <div class="table-responsive">
                <table class="table dashboard-table compact-table game-review-table">
                    <thead>
                        <tr>
                            <th title="Squad slot: 1-15 the XV, 16-23 the bench">Slot</th>
                            <th>Player</th>
                            <th>XV</th>
                            <th><a class="sort-link" href="@SortUrl(GameReviewMatrix.MinutesKey)" title="Minutes played">Min@(SortMarker(GameReviewMatrix.MinutesKey))</a></th>
                            <th><a class="sort-link" href="@SortUrl(GameReviewMatrix.PointsKey)" title="Points">Pts@(SortMarker(GameReviewMatrix.PointsKey))</a></th>
                            <th><a class="sort-link" href="@SortUrl(GameReviewMatrix.EnergyAfterKey)" title="Energy after the game">E-after@(SortMarker(GameReviewMatrix.EnergyAfterKey))</a></th>
                            <th><a class="sort-link" href="@SortUrl(GameReviewMatrix.CsrKey)" title="CSR from the latest Squad Snapshot — blank when the Player is not in it">CSR@(SortMarker(GameReviewMatrix.CsrKey))</a></th>
                            @foreach (var field in Model.GroupFields)
                            {
                                <th title="@field.Title"><a class="sort-link" href="@SortUrl(field.Key)">@field.Label@(SortMarker(field.Key))</a></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.GameRows)
                    {
                        <tr>
                            <td>@row.Slot</td>
                            <td>@row.Name</td>
                            <td>
                                @if (row.IsBench)
                                {
                                    <span class="pill neutral-pill">Bench</span>
                                }
                                else
                                {
                                    <span class="pill success-pill">XV</span>
                                }
                            </td>
                            @* The cells read per the chosen mode: delta-only mode hides
                               the value, values mode hides the movement, and the CSR
                               column (present state, no per-Fixture history) always shows
                               what it has rather than a dash that would read as "no
                               movement". *@
                            @foreach (var cell in row.Cells)
                            {
                                <td class="num">
                                    @if (Model.Mode != DeltaMode.Delta || !cell.TracksHistory)
                                    {
                                        @cell.Text
                                    }
                                    @if (cell.TracksHistory && Model.Mode != DeltaMode.Values)
                                    {
                                        <span class="cell-delta @GameReviewMatrix.DeltaClass(cell.Delta)"
                                              title="@DeltaTitle(cell.Delta)">@GameReviewMatrix.DeltaText(cell.Delta)</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<section class="chart-grid">
    <article class="chart-panel full-width-panel">
        <div class="section-heading">
            <h2>Member stats comparison</h2>
            @if (Model.HasCapture)
            {
                <p>View all squad members ranked by a specific stat — the values are your latest capture's, blank where a value is not captured yet.</p>
            }
            else
            {
                <p>No Squad Snapshot yet — Capture squad records CSR, form, energy and salary for every player, and this card ranks the squad from there.</p>
            }
        </div>
        @if (Model.HasCapture)
        {
            @* C4 carries its selection on the query string like every other card:
               the selector is a form and the bars are server-rendered HTML, so the
               chart needs no script and no charting library. *@
            <form method="get" class="game-review-controls comparison-controls">
                <label>
                    <span>Select stat</span>
                    <select name="c4stat" class="form-control" data-autosubmit>
                        @foreach (var statGroup in Model.ComparisonStatOptions.GroupBy(option => option.Group))
                        {
                            <optgroup label="@statGroup.Key">
                                @foreach (var option in statGroup)
                                {
                                    <option value="@option.Key" selected="@(option.Key == Model.ComparisonStatKey)">@option.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <input type="hidden" name="game" value="@reviewGame" />
                <input type="hidden" name="tab" value="@reviewTab" />
                <input type="hidden" name="mode" value="@reviewMode" />
                <input type="hidden" name="sort" value="@Model.SortKey" />
                <input type="hidden" name="dir" value="@reviewDir" />
                <input type="hidden" name="teamtab" value="@TeamReviewBuilder.KeyFor(Model.ReviewTab)" />
                <noscript>
                    <button type="submit" class="btn btn-outline-secondary action-button">Show</button>
                </noscript>
            </form>
            @if (Model.ComparisonBars.Count > 0)
            {
                <div class="hbar-list">
                    @foreach (var bar in Model.ComparisonBars)
                    {
                        <div class="hbar-row">
                            <div class="hbar-name" title="@bar.Name">@bar.Name</div>
                            <div class="hbar-track">
                                <div class="hbar-fill @(bar.BelowTop ? "hbar-fill-soft" : string.Empty)" style="width:@bar.Percent%"></div>
                                <div class="hbar-median" style="left:@Model.ComparisonMedianPercent%" title="Squad median"></div>
                            </div>
                            <div class="hbar-value">@bar.Value</div>
                        </div>
                    }
                </div>
            }
        }
    </article>

</section>

@* C6 Team review (S6, #38): eight team trends across the cached window as
   small-multiple line charts, each on its own scale, time running oldest to
   newest. Inline SVG with no chart library; hover a point for its value. The tab
   rides the query string, so switching is a plain link. *@
<section class="chart-grid">
    <article class="chart-panel full-width-panel">
        <div class="section-heading">
            <h2>Team review</h2>
            @if (Model.TeamReviewCharts.Count > 0)
            {
                <p>
                    Team trends across the cached window, oldest to newest — each chart on its own
                    scale. Points show their value on hover; possession, territory and minutes in 22
                    are shares of the Fixture total.
                </p>
            }
            else
            {
                <p>No cached games yet — open a Fixture and it lands here.</p>
            }
        </div>
        @if (Model.TeamReviewCharts.Count > 0)
        {
            <ul class="nav nav-pills stat-group-tabs">
                @foreach (var tab in Model.ReviewTabs)
                {
                    <li class="nav-item">
                        <a class="nav-link @(tab == Model.ReviewTab ? "active" : string.Empty)"
                           href="@TeamTabUrl(tab)">@TeamReviewBuilder.LabelFor(tab)</a>
                    </li>
                }
            </ul>
            <div class="chart-legend">
                <span><i class="legend-us"></i>Us</span>
                <span><i class="legend-adverse"></i>Opponent / adverse</span>
            </div>
            @Html.Raw(SvgCharts.SmallMultipleGrid(Model.TeamReviewCharts))
        }
    </article>
</section>
}

<partial name="_DebugPanel" />

<script id="apiLogsData" type="application/json">@Html.Raw(Model.ApiLogsJson)</script>
