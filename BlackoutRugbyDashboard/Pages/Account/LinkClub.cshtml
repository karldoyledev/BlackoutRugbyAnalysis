@page
@model BlackoutRugbyDashboard.Pages.Account.LinkClubModel
@{
    ViewData["Title"] = "Link your club";
}

<div class="container account-page">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="mb-1">Link your club</h1>
            <p class="text-muted">
                Your Member ID and Member Key authorize the dashboard to read your club's data.
                They are live-validated once, the key is stored encrypted, and it is never shown again.
                The key changes whenever you change your in-game password — Settings can re-link.
            </p>

            <form method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.MemberId" class="form-label"></label>
                    <input asp-for="Input.MemberId" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Input.MemberId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.MemberKey" class="form-label"></label>
                    <input asp-for="Input.MemberKey" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.MemberKey" class="text-danger"></span>
                    <small class="form-text text-muted">The game-issued key in your game UI — not your in-game password.</small>
                </div>
                <button type="submit" class="btn btn-primary">Link club</button>
                <a href="/" class="btn btn-link">Skip for now</a>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">@Model.ErrorMessage</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}